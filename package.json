{
  "name": "library-management-system",
  "version": "1.0.0",
  "description": "Lightweight Folio Library Management System with database-enforced circulation rules, role-based REST API, and modern archival UI.",
  "type": "module",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "import:csv": "node scripts/import-csv.js",
    "bench": "node scripts/benchmark.js",
    "test": "node --test backend/tests/*.test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  }
}
